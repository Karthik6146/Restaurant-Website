rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function text(value, max) { return value is string && value.size() <= max; }
    function email(value) { return text(value, 254) && value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'); }
    match /menu/{dish} {
      allow read: if true;
      allow write: if false;
    }
    match /reservations/{reservation} {
      allow create: if request.resource.data.keys().hasAll(['date', 'time', 'partySize', 'name', 'email', 'specialRequests', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['date', 'time', 'partySize', 'name', 'email', 'specialRequests', 'status', 'createdAt'])
        && text(request.resource.data.name, 100) && request.resource.data.name.matches('.*[^\\s].*')
        && email(request.resource.data.email)
        && request.resource.data.partySize is int && request.resource.data.partySize >= 1 && request.resource.data.partySize <= 10
        && text(request.resource.data.date, 10) && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && text(request.resource.data.time, 5) && request.resource.data.time.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && text(request.resource.data.specialRequests, 1000)
        && request.resource.data.status == 'requested'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /newsletter/{subscription} {
      allow create: if request.resource.data.keys().hasAll(['email', 'consent', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'consent', 'createdAt'])
        && email(request.resource.data.email) && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
